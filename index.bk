<script>
const rm=matchMedia('(prefers-reduced-motion:reduce)').matches;
// SplitText: pecah per kata, muncul bergantian
document.querySelectorAll('[data-split]').forEach(h=>{const out=[];let i=0;
 h.childNodes.forEach(n=>{const it=n.nodeType===1;(n.textContent.trim().split(/\s+/)).forEach(w=>{out.push(`<span class="ln">${it?'<em>':''}<span style="animation-delay:${i++*70}ms">${w}</span>${it?'</em>':''}</span>`)})});
 h.innerHTML=out.join(' ').replace(/<\/span> <span class="ln">/g,'</span><span class="ln" style="display:inline-block;margin-right:.22em">').replace(/<span class="ln">/g,'<span class="ln" style="display:inline-block;margin-right:.22em">')});
// pola bintang
function star(svg,layers,seed){const NS='http://www.w3.org/2000/svg';for(let k=0;k<layers;k++){const r=96-k*(88/layers),rot=k*Math.PI/(layers*2)+seed;let d='';
 for(let i=0;i<=8;i++){const a=rot+(i*3%8)*Math.PI/4-Math.PI/2;d+=(i?'L':'M')+(r*Math.cos(a)).toFixed(2)+' '+(r*Math.sin(a)).toFixed(2)}
 const p=document.createElementNS(NS,'path');p.setAttribute('d',d+'Z');p.setAttribute('pathLength','1');p.style.animationDelay=(k*.25)+'s';svg.appendChild(p)}}
// Topografi WebGL: kontur berperspektif, bereaksi pada kursor dan kecepatan scroll
(function(){const cv=document.getElementById('topo'),gl=cv.getContext('webgl2');if(!gl)return;
const sh=(t,s)=>{const x=gl.createShader(t);gl.shaderSource(x,s);gl.compileShader(x);return x},pr=gl.createProgram();
gl.attachShader(pr,sh(gl.VERTEX_SHADER,`#version 300 es
void main(){vec2 p=vec2(float((gl_VertexID<<1)&2),float(gl_VertexID&2));gl_Position=vec4(p*2.-1.,0.,1.);}`));
gl.attachShader(pr,sh(gl.FRAGMENT_SHADER,`#version 300 es
precision highp float;uniform vec2 R,M;uniform float T;uniform vec3 C;out vec4 o;
float hs(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float nz(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(hs(i),hs(i+vec2(1,0)),f.x),mix(hs(i+vec2(0,1)),hs(i+vec2(1,1)),f.x),f.y);}
float fb(vec2 p){float a=.5,s=0.;for(int i=0;i<4;i++){s+=a*nz(p);p=p*2.03+vec2(7.1,3.7);a*=.5;}return s;}
void main(){vec2 uv=gl_FragCoord.xy/R;float d=.9-uv.y;if(d<=0.){o=vec4(0);return;}
 float z=.45/max(d,.015);vec2 g=vec2((uv.x-.5)*z*R.x/R.y,z+T);
 float md=length((uv-M)*vec2(R.x/R.y,1.));
 float e=fb(g*.5)+exp(-md*md*12.)*.18;
 float l=e*22.,w=fwidth(l),dd=abs(fract(l-.5)-.5);
 float a=1.-smoothstep(w*.4,w*1.6,dd);a*=1.-smoothstep(.3,.8,w);
 float mj=1.-step(.5,mod(floor(l+.5),5.));
 float br=(.4+e*1.2+mj*.7)*smoothstep(0.,.2,d)*(1.-smoothstep(.45,.6,d)*.6);
 float al=clamp(a*br*.5,0.,.85);o=vec4(C*al,al);}`));
gl.linkProgram(pr);gl.useProgram(pr);
const U=n=>gl.getUniformLocation(pr,n),m={x:.5,y:.3,tx:.5,ty:.3};let t=0,vis=true,sc=0,last=0;
gl.uniform3fv(U('C'),matchMedia('(prefers-color-scheme:dark)').matches?[.4,.85,.78]:[.06,.3,.28]);
const size=()=>{const r=Math.min(devicePixelRatio||1,1.5);cv.width=Math.max(1,cv.clientWidth*r|0);cv.height=Math.max(1,cv.clientHeight*r|0);gl.viewport(0,0,cv.width,cv.height)};
new ResizeObserver(size).observe(cv);
addEventListener('pointermove',e=>{const r=cv.getBoundingClientRect();m.tx=(e.clientX-r.left)/r.width;m.ty=1-(e.clientY-r.top)/r.height},{passive:true});
new IntersectionObserver(e=>vis=e[0].isIntersecting).observe(cv);
(function draw(ts){requestAnimationFrame(draw);if(!vis)return;const dt=Math.min((ts-last)/1000||0,.05);last=ts;
 if(!rm)t+=dt*(.25+Math.min(Math.abs(scrollY-sc)*.04,3));sc=scrollY;
 m.x+=(m.tx-m.x)*.08;m.y+=(m.ty-m.y)*.08;
 gl.uniform2f(U('R'),cv.width,cv.height);gl.uniform2f(U('M'),m.x,m.y);gl.uniform1f(U('T'),t);
 gl.clearColor(0,0,0,0);gl.clear(gl.COLOR_BUFFER_BIT);gl.drawArrays(gl.TRIANGLES,0,3)})(0);
})();
// Gerak halaman: kata menyala mengikuti scroll, parallax hero dan cover, header menyembunyi, konten masuk bertahap
document.querySelectorAll('[data-scrub]').forEach(p=>{const out=[];p.childNodes.forEach(n=>{const e=n.nodeType===1;n.textContent.trim().split(/\s+/).forEach(w=>out.push(`<span class="sw">${e?'<em>'+w+'</em>':w}</span>`))});p.innerHTML=out.join(' ')});
const sw=[...document.querySelectorAll('.sw')],h1=document.querySelector('.hero h1'),covs=[...document.querySelectorAll('.cov svg')],hd=document.querySelector('header');let ly=0,tk=false;
function onS(){tk=false;const y=scrollY,vh=innerHeight;hd.classList.toggle('hide',y>ly&&y>200);ly=y;
 if(!rm){h1.style.transform=`translateY(${Math.min(y,vh)*.18}px)`;h1.style.opacity=1-Math.min(y/(vh*.8),1)}
 sw.forEach(s=>{const r=s.getBoundingClientRect(),p=1-(r.top-vh*.45)/(vh*.3);s.style.opacity=rm?1:.16+.84*Math.max(0,Math.min(p,1))});
 if(!rm)covs.forEach(s=>{const r=s.parentNode.getBoundingClientRect(),k=(r.top+r.height/2-vh/2)/vh;s.style.transform=`translateY(${k*-40}px) scale(1.18) rotate(${k*6}deg)`})}
addEventListener('scroll',()=>{if(!tk){tk=true;requestAnimationFrame(onS)}},{passive:true});onS();
const rvIO=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');rvIO.unobserve(e.target)}}),{threshold:.15});
document.querySelectorAll('.head,.fc,.s,.steps li,.tr div,.stats div,.cta p,.cta .row,.fg>div').forEach((el,i)=>{if(rm)return;el.classList.add('rv');el.style.transitionDelay=(i%4)*70+'ms';rvIO.observe(el)});
// produk unggulan
const W=[["INISIASI","Satu ekosistem untuk akademik, spiritual, sosial, dan ekonomi pondok.","Pendidikan · Sistem","#0f3d3a,#1b6b5f"],
["HRIS by Khwarizmi","Absensi, persetujuan dokumen, hingga payroll untuk perusahaan Anda.","Bisnis · Sistem","#14233f,#2147b8"],
["QuranMemo","Menghafal dengan streak, setoran ke musyrif, dan halaqah.","Pendidikan · Mobile","#2a2410,#8a6a2a"],
["Character Development","Rapor karakter santri dari pengamatan guru, dengan rekomendasi pembinaan.","Pendidikan · Sistem","#1d1a33,#4b3fa0"],
["AI Islami","Asisten tanya-jawab yang merujuk Al-Qur’an dan Hadis lewat RAG.","Pendidikan · AI","#0c2a33,#1e8a9a"],
["BIZ Marketplace","Order, pembayaran, logistik, dan laporan dalam satu panel admin.","Bisnis · Platform","#2b1414,#a04a3a"]];
// Folder native: tata letak baris, pegas buka-tutup, melayang, tabrakan, dan seret (tanpa matter-js)
const FT=[["CCTV for Parents","Tahfidz Management","PPDB","Online Donation","Finance & Payment","Marketplace"],["Attendance System","Document Approval","BPJS Integration","Payroll Management","Shifting Management","Time Off"],["Streak harian","Badge per surat","Setoran ke musyrif","Group halaqah","Leaderboard hafalan"],["Input via smartphone","Rekomendasi treatment","Verifikasi guru","Rapor pembelajaran"],["Rujukan Al-Qur’an","Rujukan Hadis","Berbasis RAG","Tanya-jawab"],["Admin Panel","User Role","Payment Gateway","Tracking & Logistic","Order System","Report & Finance"]];
const wk=document.getElementById('work'),touch=matchMedia('(hover:none)').matches;
const wa=(n,f)=>window.open('https://wa.me/6281282251136?text='+encodeURIComponent(`Halo Khwarizmi, saya tertarik dengan ${n}, khususnya fitur ${f}.`),'_blank','noopener');
function folder(ff,name){const pills=[...ff.querySelectorAll('.fp')],btn=ff.querySelector('.fbtn'),fi=ff.querySelector('.fi'),LIFT=26,ROW=52;
 let isOpen=false,raf=0,t0=0,last=0,drag=null,SP=140,S=[];
 function layout(){SP=Math.min(140,ff.offsetWidth/2-4);const rows=[];let row=[],wd=0;
  pills.forEach((el,i)=>{const w=el.offsetWidth;if(row.length&&wd+12+w>SP*2){rows.push({row,wd});row=[];wd=0}row.push({i,w});wd+=(row.length>1?12:0)+w});
  if(row.length)rows.push({row,wd});
  rows.forEach((r,ri)=>{let x=-r.wd/2;r.row.forEach(({i,w})=>{const j=Math.abs(Math.sin(i*12.9898+4.14)*43758.5453)%1;S[i]={w,h:34,hx:x+w/2,hy:-LIFT-ri*ROW-17-j*6,x:0,y:30,vx:0,vy:0,s:.6,o:0,r:(j-.5)*16,ph:j*6.28};x+=w+12})})}
 layout();document.fonts&&document.fonts.ready.then(()=>{if(!isOpen)layout()});
 function tick(now){raf=requestAnimationFrame(tick);if(!t0)t0=now;const dt=Math.min(.033,(now-(last||now))/1000||.016);last=now;const el=now-t0,free=isOpen&&el>900+S.length*45;
  S.forEach((p,i)=>{if(drag&&drag.i===i)return;
   if(rm){const on=isOpen;p.x=on?p.hx:0;p.y=on?p.hy:30;p.s=1;p.o=on?1:0;return}
   if(isOpen){if(el<i*45)return;
    if(!free){p.vx+=((p.hx-p.x)*90-p.vx*11)*dt;p.vy+=((p.hy-p.y)*90-p.vy*11)*dt;p.s+=(1-p.s)*Math.min(1,dt*12);p.o=Math.min(1,p.o+dt*8)}
    else{p.vx+=Math.sin(now/1100+p.ph)*40*dt;p.vy+=Math.cos(now/760+p.ph*1.7)*40*dt;p.vx*=.985;p.vy*=.985}}
   else{p.vx+=(-p.x*60-p.vx*10)*dt;p.vy+=((30-p.y)*60-p.vy*10)*dt;p.s+=(.6-p.s)*Math.min(1,dt*10);p.o=Math.max(0,p.o-dt*7)}
   p.x+=p.vx*dt;p.y+=p.vy*dt});
  if(free&&!rm){const L=-SP-8,R=SP+8,T=Math.min(...S.map(p=>p.hy-p.h/2))-8,B=-LIFT+20;
   S.forEach(p=>{if(p.x-p.w/2<L){p.x=L+p.w/2;p.vx=Math.abs(p.vx)*.55}if(p.x+p.w/2>R){p.x=R-p.w/2;p.vx=-Math.abs(p.vx)*.55}if(p.y-p.h/2<T){p.y=T+p.h/2;p.vy=Math.abs(p.vy)*.55}if(p.y+p.h/2>B){p.y=B-p.h/2;p.vy=-Math.abs(p.vy)*.55}});
   for(let a=0;a<S.length;a++)for(let b=a+1;b<S.length;b++){const A=S[a],C=S[b],ox=(A.w+C.w)/2-Math.abs(A.x-C.x),oy=(A.h+C.h)/2-Math.abs(A.y-C.y);
    if(ox>0&&oy>0){if(ox<oy){const s=A.x<C.x?-1:1;A.x+=s*ox/2;C.x-=s*ox/2;const v=A.vx;A.vx=C.vx*.8;C.vx=v*.8}else{const s=A.y<C.y?-1:1;A.y+=s*oy/2;C.y-=s*oy/2;const v=A.vy;A.vy=C.vy*.8;C.vy=v*.8}}}}
  pills.forEach((e,i)=>{const p=S[i];e.style.opacity=p.o;e.style.transform=`translate(${(p.x-p.w/2).toFixed(1)}px,${(p.y-p.h/2).toFixed(1)}px) rotate(${p.r}deg) scale(${p.s.toFixed(3)})`});
  if(!isOpen&&S.every(p=>p.o<.01)){cancelAnimationFrame(raf);raf=0}}
 function set(v){isOpen=v;btn.setAttribute('aria-expanded',v);ff.classList.toggle('o',v);pills.forEach(e=>e.tabIndex=v?0:-1);t0=0;last=0;if(!raf)raf=requestAnimationFrame(tick)}
 if(!touch){ff.addEventListener('pointerenter',()=>set(true));ff.addEventListener('pointerleave',()=>{if(!drag)set(false)})}
 btn.addEventListener('click',e=>{if(touch||e.detail===0)set(!isOpen)});
 ff.addEventListener('keydown',e=>{if(e.key==='Escape')set(false)});
 pills.forEach((el,i)=>{
  el.addEventListener('pointerdown',e=>{if(e.button!==0)return;const r=fi.getBoundingClientRect();drag={i,id:e.pointerId,sx:e.clientX,sy:e.clientY,moved:false,dx:S[i].x-(e.clientX-r.left),dy:S[i].y-(e.clientY-r.top)};el.setPointerCapture(e.pointerId)});
  el.addEventListener('pointermove',e=>{if(!drag||drag.i!==i)return;if(!drag.moved&&Math.hypot(e.clientX-drag.sx,e.clientY-drag.sy)>4)drag.moved=true;if(!drag.moved)return;const r=fi.getBoundingClientRect(),p=S[i];p.x=e.clientX-r.left+drag.dx;p.y=e.clientY-r.top+drag.dy;p.vx=p.vy=0});
  el.addEventListener('pointerup',e=>{if(!drag||drag.i!==i)return;const m=drag.moved;drag=null;if(!m)wa(name,el.textContent)});
  el.addEventListener('click',e=>{if(e.detail===0)wa(name,el.textContent)})})}
W.forEach((p,i)=>{const [a,b]=p[3].split(',');const el=document.createElement('article');el.className='fc';
 el.innerHTML=`<div class="ff" style="--b:${a};--f:${b}"><div class="fi">${FT[i].map(t=>`<button class="fp" tabindex="-1">${t}</button>`).join('')}</div><div class="fb"><span class="fk"></span><span class="fpp"></span><span class="ffr"><b>${p[0]}</b><small>${p[2]}</small></span><button class="fbtn" aria-expanded="false" aria-label="${p[0]}, ${FT[i].length} fitur"></button></div></div><p class="fd">${p[1]}</p>`;
 wk.appendChild(el);folder(el.querySelector('.ff'),p[0])});
// marquee yang bereaksi pada kecepatan scroll (ScrollVelocity)
const N=["HRIS","Workspace","INISIASI","QuranMemo","StockFlow","AI Islami","AMS","Pojok Pustaka","Tadarus Apps","Document Flow","SILAKBAN","QMT"];
const mq=document.getElementById('mq');mq.innerHTML=[...N,...N].map(t=>`<span>${t}</span>`).join('');
let x=0,v=1,last=scrollY;(function loop(){const d=scrollY-last;last=scrollY;v+=(Math.min(Math.abs(d)*.25,8)+1-v)*.08;if(!rm)x-=v*.6;const half=mq.scrollWidth/2;if(-x>=half)x+=half;mq.style.transform=`translate3d(${x}px,0,0)`;requestAnimationFrame(loop)})();
// CountUp
const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;io.unobserve(e.target);const el=e.target,to=+el.dataset.n,s=el.dataset.s||'',t0=performance.now();
 (function f(t){const k=Math.min((t-t0)/1400,1),eased=1-Math.pow(1-k,4);el.textContent=Math.round(to*eased)+(k===1?s:'');if(k<1&&!rm)requestAnimationFrame(f);else el.textContent=to+s})(t0)}),{threshold:.6});
document.querySelectorAll('[data-n]').forEach(e=>io.observe(e));
// Magnet pada tombol
if(!rm&&matchMedia('(pointer:fine)').matches)document.querySelectorAll('.mag').forEach(m=>{m.addEventListener('pointermove',e=>{const r=m.getBoundingClientRect();m.style.transform=`translate(${(e.clientX-r.left-r.width/2)*.2}px,${(e.clientY-r.top-r.height/2)*.3}px)`});m.addEventListener('pointerleave',()=>m.style.transform='')});
// jam
const c=document.getElementById('clock');function tick(){try{c.textContent='Bogor '+new Date().toLocaleTimeString('id-ID',{timeZone:'Asia/Jakarta',hour:'2-digit',minute:'2-digit'})+' WIB'}catch(e){}}tick();setInterval(tick,30000);
</script>
</body>
</html>
