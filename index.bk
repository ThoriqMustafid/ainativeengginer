<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Khwarizmi · Software Islami untuk bisnis dan pendidikan</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#0c0e10;--paper:#f5f5f1;--fg:#0c0e10;--mut:#6b6f73;--line:rgb(12 14 16/.14);--acc:#3cc2b0;--sans:"Inter Tight",system-ui,sans-serif;--ease:cubic-bezier(.2,.7,.1,1);--g:clamp(20px,4vw,48px);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--paper:#121416;--fg:#ecece8;--mut:#8f9498;--line:rgb(236 236 232/.14)}}
:root[data-theme="dark"]{--paper:#121416;--fg:#ecece8;--mut:#8f9498;--line:rgb(236 236 232/.14)}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{margin:0;background:var(--paper);color:var(--fg);font:400 1.05rem/1.6 var(--sans);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--acc);outline-offset:3px}
.w{max-width:90rem;margin:0 auto;padding:0 var(--g)}
h1,h2,h3{margin:0;font-weight:500;letter-spacing:-.04em;line-height:.98}
em{font-style:normal;color:var(--mut)}
.sec{padding:clamp(80px,11vw,160px) 0}
.meta{font-size:.85rem;color:var(--mut)}
.pill{display:inline-flex;align-items:center;gap:.6em;background:var(--fg);color:var(--paper);border-radius:999px;padding:.8em 1.4em;font-weight:500;font-size:.95rem;transition:transform .4s var(--ease)}
.pill.l{background:#f2f1ed;color:var(--ink)}
.lnk{border-bottom:1px solid currentColor;padding-bottom:2px;font-weight:500}
.dk{background:var(--ink);color:#ecece8;--line:rgb(236 236 232/.16);--mut:#8f9498}
/* nav */
header{position:fixed;inset:0 0 auto;z-index:30;padding-top:env(safe-area-inset-top,0px);color:#ecece8}
header .w{display:flex;justify-content:space-between;align-items:center;height:68px}
.logo{font-weight:700;letter-spacing:-.03em;font-size:1.2rem}
nav{display:flex;gap:26px;align-items:center;font-size:.92rem}nav a{opacity:.75}nav a:hover{opacity:1}nav .pill{opacity:1;padding:.55em 1.1em}
@media(max-width:820px){nav a:not(.pill){display:none}}
/* hero */
.hero{min-height:100svh;padding:120px 0 40px;position:relative;overflow:hidden;display:flex;align-items:flex-end}.hero .w{width:100%;position:relative;z-index:2}#topo{position:absolute;inset:0;width:100%;height:100%;opacity:.85}
header{transition:transform .6s var(--ease)}header.hide{transform:translateY(-100%)}
.rv{opacity:0;transform:translateY(40px);transition:opacity 1s var(--ease),transform 1s var(--ease)}.rv.in{opacity:1;transform:none}
.sw{display:inline-block;opacity:.16}
.hero .top{font-size:.9rem;color:#9aa0a4;margin-bottom:28px}
.hero h1{font-size:clamp(3rem,9.6vw,9.5rem);max-width:13ch}
.ln{display:block;overflow:hidden;padding-bottom:.1em}.ln span{display:inline-block;transform:translateY(110%);animation:up 1.1s var(--ease) forwards}
@keyframes up{to{transform:none}}
.hero .row{display:flex;flex-wrap:wrap;gap:24px 40px;align-items:center;margin:40px 0 56px}
.chip{display:flex;align-items:center;gap:14px;background:#1b1e21;border-radius:999px;padding:8px 22px 8px 8px}
.chip b{display:flex}.chip b i{width:36px;height:36px;border-radius:50%;border:2px solid #1b1e21;margin-right:-10px;background:linear-gradient(135deg,#3cc2b0,#2147b8)}.chip b i+i{background:linear-gradient(135deg,#e8d9a8,#8a6a2a)}
.chip small{display:block;color:#8f9498;font-size:.8rem}
.reel{position:relative;aspect-ratio:21/9;border-radius:18px;overflow:hidden;background:radial-gradient(ellipse at 70% 40%,#10343a,#0a1b24 60%,#06100f)}
@media(max-width:700px){.reel{aspect-ratio:4/3}}
.reel svg{position:absolute;inset:-30% 0 auto auto;height:160%;aspect-ratio:1;right:-5%;opacity:.9}
.reel path{fill:none;stroke:var(--acc);stroke-width:1;vector-effect:non-scaling-stroke;stroke-dasharray:1;stroke-dashoffset:1;animation:dr 3.4s var(--ease) forwards}
.reel path:nth-child(even){stroke:#6f8df0}
@keyframes dr{to{stroke-dashoffset:0}}
.reel .cap{position:absolute;left:28px;bottom:24px;font-size:clamp(1.6rem,4vw,3.4rem);letter-spacing:-.04em;max-width:14ch;line-height:1}
.reel .tag{position:absolute;left:28px;top:22px;font-size:.8rem;color:#9aa0a4}
.reel .play{position:absolute;right:24px;bottom:22px;font-size:.85rem;color:#cfd6d6}
.blur span{display:inline-block;filter:blur(10px);opacity:0;animation:bl .9s var(--ease) forwards}
@keyframes bl{to{filter:none;opacity:1}}
.facts{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:28px;font-size:.9rem}.facts span{display:block;color:#8f9498}
/* intro */
.intro{display:grid;grid-template-columns:1fr 2fr;gap:48px}.intro p{font-size:clamp(1.4rem,2.6vw,2.4rem);line-height:1.2;letter-spacing:-.025em;margin:0}
.stats{display:grid;grid-template-columns:repeat(4,1fr);margin-top:72px;border-top:1px solid var(--line)}
.stats div{padding:24px 12px 0 0}.stats b{display:block;font-size:clamp(2.6rem,6vw,5.5rem);font-weight:500;letter-spacing:-.05em;line-height:1}
@media(max-width:800px){.intro{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}}
/* marquee */
.mq{overflow:hidden;border-block:1px solid var(--line);padding:22px 0}.mq>div{display:flex;gap:56px;width:max-content;will-change:transform;font-size:clamp(1.4rem,3vw,2.4rem);letter-spacing:-.03em;color:var(--mut)}
/* work */
.head{display:flex;justify-content:space-between;align-items:end;margin-bottom:48px;gap:24px}.head h2{font-size:clamp(2.4rem,6vw,5.5rem)}
.work{display:grid;grid-template-columns:repeat(3,1fr);gap:24px 40px}
@media(max-width:1000px){.work{grid-template-columns:1fr 1fr}}@media(max-width:640px){.work{grid-template-columns:1fr}}
.fc{position:relative;padding-top:250px}.fc:hover,.fc:focus-within{z-index:5}
.fd{margin:22px 0 0;max-width:300px;color:var(--mut)}
.ff{position:relative;width:min(300px,100%);margin-top:14px}
.ff.o::before{content:"";position:absolute;left:-60px;right:-60px;top:-250px;height:250px}
.fb{position:relative;height:200px}
.fk{position:absolute;inset:0;border-radius:14px;background:var(--b);transform:perspective(600px) rotateX(8deg);transform-origin:50% 100%}
.fk::before{content:"";position:absolute;top:-14px;left:0;width:42%;height:28px;border-radius:14px 14px 0 0;background:inherit}
.fpp{position:absolute;top:10%;left:8%;right:8%;height:50%;border-radius:6px;background:#f2f1ed;opacity:0;transform:translateY(10px);transition:transform .31s var(--ease),opacity .31s}
.ffr{position:absolute;left:0;right:0;bottom:0;height:76%;padding:14px 16px;display:flex;flex-direction:column;justify-content:flex-end;gap:5px;border-radius:14px;background:linear-gradient(180deg,color-mix(in srgb,var(--f) 92%,#fff),var(--f) 60%);color:#f2f1ed;box-shadow:0 -10px 24px rgba(0,0,0,.28);transform:perspective(600px) rotateX(-16deg);transform-origin:50% 100%;transition:transform .52s var(--ease);z-index:2}
.ffr b{font-weight:500;font-size:1rem}.ffr small{font-size:.75rem;opacity:.6}
.ff.o .ffr{transform:perspective(600px) rotateX(-34deg)}.ff.o .fpp{opacity:1;transform:none;transition:transform .52s var(--ease),opacity .2s}
.fbtn{position:absolute;left:0;right:0;bottom:0;height:76%;z-index:3;background:none;border:0;border-radius:14px;cursor:pointer}
.fi{position:absolute;left:50%;top:14px;width:0;height:0;z-index:1}
.fp{position:absolute;left:0;top:0;height:34px;padding:0 14px;border:0;border-radius:17px;background:#f2f1ed;color:#0c0e10;font:inherit;font-size:.85rem;white-space:nowrap;box-shadow:0 4px 12px rgba(0,0,0,.14);cursor:grab;opacity:0;pointer-events:none;touch-action:none;will-change:transform}
.ff.o .fp{pointer-events:auto}.fp:active{cursor:grabbing}
.cov{position:relative;aspect-ratio:4/3;border-radius:14px;overflow:hidden;--x:50%;--y:50%;transition:transform .8s var(--ease)}
.cov::after{content:"";position:absolute;inset:0;background:radial-gradient(420px circle at var(--x) var(--y),rgb(255 255 255/.22),transparent 60%);opacity:0;transition:opacity .4s}
.work a:hover .cov::after{opacity:1}.work a:hover .cov{transform:scale(.985)}
.cov svg{position:absolute;inset:0;width:100%;height:100%}.cov path{fill:none;stroke:rgb(255 255 255/.5);stroke-width:1;vector-effect:non-scaling-stroke}
.cov i{position:absolute;left:18px;top:14px;font-style:normal;font-size:.8rem;color:rgb(255 255 255/.8)}
.wt{display:flex;justify-content:space-between;gap:16px;margin-top:18px}.wt h3{font-size:1.8rem}.wt p{margin:6px 0 0;color:var(--mut);max-width:30ch}.wt .meta{text-align:right}
/* services */
.svc{border-top:1px solid var(--line)}
.s{display:grid;grid-template-columns:1fr 1.3fr 1fr;gap:32px;padding:44px 0;border-bottom:1px solid var(--line)}
.s h3{font-size:clamp(2rem,4vw,3.6rem)}.s h3+p{margin:14px 0 0;max-width:22ch;color:var(--mut);font-size:1.2rem;line-height:1.3}
.s dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:10px 28px;font-size:.95rem}.s dt{color:var(--mut)}.s dd{margin:0}
.s .lnk{align-self:end;justify-self:start}
@media(max-width:860px){.s{grid-template-columns:1fr}}
/* process */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:28px;margin-top:56px;list-style:none;padding:0}
.steps li{border-top:1px solid var(--line);padding-top:20px}.steps b{font-weight:400;color:var(--mut);font-size:.9rem}.steps h3{font-size:2rem;margin:14px 0 12px}.steps p{margin:0;color:var(--mut)}
@media(max-width:900px){.steps{grid-template-columns:1fr 1fr}}@media(max-width:520px){.steps{grid-template-columns:1fr}}
/* trust */
.tr{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px}
.tr div{border:1px solid var(--line);border-radius:14px;padding:28px;min-height:200px;display:flex;flex-direction:column;justify-content:space-between}
.tr p{margin:0;font-size:1.5rem;line-height:1.2;letter-spacing:-.02em}
@media(max-width:860px){.tr{grid-template-columns:1fr}}
/* cta + footer */
.cta h2{font-size:clamp(3rem,10vw,10rem)}.cta p{max-width:34rem;color:#9aa0a4;margin:32px 0}
.cta .row{display:flex;gap:28px;align-items:center;flex-wrap:wrap}
footer{padding:64px 0 32px}.fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:32px}.fg h4{margin:0 0 12px;font-size:1.3rem;font-weight:500}.fg p,.fg a{color:var(--mut);font-size:.92rem;display:block;margin:0 0 6px}.fg a:hover{color:#fff}
.fb{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-top:64px;padding-top:20px;border-top:1px solid var(--line);font-size:.85rem;color:var(--mut)}
@media(max-width:800px){.fg{grid-template-columns:1fr 1fr}}
.mag{will-change:transform}
/* Hero terang bergaya Keffi: nav pil di tengah, headline terpusat, panel besar berlatar lembut */
header{color:var(--fg)}header .w{display:grid;grid-template-columns:1fr auto 1fr;height:76px}header .cta-n{justify-self:end}
nav{gap:4px;padding:5px;border:1px solid var(--line);border-radius:999px;background:color-mix(in srgb,var(--paper) 80%,transparent);backdrop-filter:blur(10px)}
nav a{opacity:1;padding:.5em 1em;border-radius:999px}nav a:hover{background:rgb(12 14 16/.06)}
@media(max-width:820px){nav{display:none}header .w{display:flex;justify-content:space-between}}
.hero{display:block;min-height:0;padding:150px 0 0;background:var(--paper);color:var(--fg);overflow:visible}
.hero .w{text-align:center}
.hero .top{display:inline-flex;align-items:center;gap:10px;margin-bottom:28px;color:var(--mut);font-size:.95rem}
.hero .top i{width:7px;height:7px;border-radius:50%;background:#4b3fd6}
.hero h1{font-size:clamp(2.6rem,7vw,7.4rem);max-width:none;letter-spacing:-.055em;line-height:.95}
.hero .row{justify-content:center;margin:44px 0 0}
.hero .chip{background:var(--ink);color:#f5f5f1;font-weight:500;padding:8px 24px 8px 8px}
.hero .cap2{margin:16px 0 0;color:var(--mut);font-size:.9rem}
.stage{position:relative;margin:72px auto 0;max-width:72rem;aspect-ratio:16/8;border:1px solid var(--line);border-bottom:0;border-radius:28px 28px 0 0;overflow:hidden;background:radial-gradient(ellipse at 50% 60%,#e3f0e4,#f3f7f1 70%)}
#topo{opacity:1}
@media(max-width:700px){.stage{aspect-ratio:4/3;margin-top:48px;border-radius:20px 20px 0 0}}
@media(prefers-color-scheme:dark){.stage{background:radial-gradient(ellipse at 50% 60%,#16322f,#0f1a1c 70%)}}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;animation-delay:0s!important;transition:none!important}.ln span{transform:none}.reel path{stroke-dashoffset:0}}
</style>
</head>
<body>
<header><div class="w"><a class="logo" href="#top">Khwarizmi</a>
<nav><a href="#tentang">Tentang</a><a href="#produk">Produk</a><a href="#layanan">Layanan</a><a href="#cara">Cara kerja</a></nav><a class="pill mag cta-n" href="https://wa.me/6281282251136">Jadwalkan konsultasi</a></div></header>

